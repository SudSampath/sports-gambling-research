# Copy this file to .env and populate values locally. Do not commit .env.
# All values below are placeholders or non-sensitive defaults.

# Kalshi public read-only market data requires no credentials.
KALSHI_API_BASE_URL=https://external-api.kalshi.com/trade-api/v2

# Everything below is reserved for a future authenticated milestone. Phase 1
# never reads these values, and the spike works with them left as placeholders.
#
# Kalshi signs each authenticated request, so creating an API key yields a key
# ID (below) and an RSA private key downloaded as a PEM file. There is no
# shared-secret string. If authenticated access is ever enabled, the demo
# environment (https://demo-api.kalshi.co/trade-api/v2) is the safe default.
KALSHI_API_KEY=replace_me

# Absolute path to the PEM downloaded from Kalshi. Store it outside the repo.
# Set KALSHI_PRIVATE_KEY_PEM instead when loading the key from a managed secret
# store; it takes precedence over the path.
KALSHI_PRIVATE_KEY_PATH=C:/secure/kalshi-key.pem
# KALSHI_PRIVATE_KEY_PEM=
# KALSHI_PRIVATE_KEY_PASSPHRASE=

# Sports APIs
THEODDS_API_BASE_URL=https://api.the-odds-api.com/v4
THEODDS_API_KEY=replace_me
SPORTSDATA_API_BASE_URL=https://api.sportsdata.io/v3
SPORTSDATA_API_KEY=replace_me

# Runtime
DEFAULT_BANKROLL=10000
RISK_PER_TRADE=0.01
